{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",

  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Lounode"
  ],
  "contact": {
    "issues": "https://github.com/Lounode/EventWrapper/issues",
    "sources": "https://github.com/lounode/EventWrapper",
    "homepage": "https://github.com/lounode/EventWrapper"
  },
  

  "license": "${mod_license}",
  "icon": "${mod_logo}",

  "environment": "*",
  "entrypoints": {
    "client": ["io.github.lounode.eventwrapper.fabric.client.FabricClientInitializer"],
    "main": ["io.github.lounode.eventwrapper.fabric.FabricCommonInitializer"],
    "preLaunch": ["io.github.lounode.eventwrapper.fabric.PreLaunchHandler"],
    "fabric-gametest": [

    ]
  },
  "mixins": [
    "eventwrapper_common.mixins.json",
    "eventwrapper_fabric.mixins.json"
  ],
  
  "accessWidener": "eventwrapper.accesswidener",

  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "fabric-api": "*"
  }
}
